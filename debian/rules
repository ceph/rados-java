#!/usr/bin/make -f

export DH_VERBOSE=1

VERSION := $(shell grep '^    <version>' pom.xml | cut -d'>' -f2 | cut -d'<' -f1)
JAVADIR := debian/librados-java/usr/share/java

%:
	dh $@

override_dh_auto_build:
	mvn -B -ntp -Dcom.ceph.rados.skipTests=true clean package

override_dh_auto_test:
	# The tests need a running Ceph cluster, see README.md

override_dh_auto_install:
	install -D -m 0644 target/rados-$(VERSION).jar $(JAVADIR)/rados-$(VERSION).jar
	dh_link usr/share/java/rados-$(VERSION).jar usr/share/java/rados.jar
	install -m 0644 target/dependencies/jna*.jar $(JAVADIR)/

override_dh_auto_clean:
	mvn -B -ntp -q clean || true
	dh_auto_clean
